{
  "name": "@invoxim/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run",
    "build": "node -e \"require('node:fs').mkdirSync('.production', { recursive: true })\" && wrangler deploy --dry-run --outdir dist --metafile .production/worker.json --no-upload-source-maps"
  },
  "dependencies": {
    "hono": "4.13.13",
    "@invoxim/contracts": "workspace:*",
    "@invoxim/core": "workspace:*",
    "@invoxim/adapters": "workspace:*",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@cloudflare/vitest-plugin": "1.4.0",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
