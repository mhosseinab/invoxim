{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".production/**"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "WRANGLER_LOG_PATH",
    "WRANGLER_REGISTRY_PATH",
    "WRANGLER_SEND_METRICS",
    "PLAYWRIGHT_BROWSERS_PATH"
  ],
  "globalDependencies": [
    "tsconfig.base.json",
    "biome.json",
    ".node-version",
    "contracts/**",
    "test-design/**"
  ]
}
