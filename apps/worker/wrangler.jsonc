{
  "name": "invoxim-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "upload_source_maps": false,
  "vars": {
    "AUTH_ENABLED": "true",
    "AUTH_ORIGIN": "https://invoxim-web.pages.dev",
    "AUTH_GOOGLE_CLIENT_ID": "563909797128-8ho9ofplbgl7cu45isplfec18umknru9.apps.googleusercontent.com",
    "GMAIL_CLIENT_ID": "563909797128-s3loaq011nlfsjl1d250kcl90h1th186.apps.googleusercontent.com",
    "CORRECTIONS_ENABLED": "false",
    "AI_ENABLED": "true",
    "AI_HOSTED_DESTINATION": "abacus-routellm",
    "AI_HOSTED_MODEL": "gpt-6-luna",
    "AI_REGISTRY_JSON": "[{\"id\":\"abacus-routellm\",\"endpoint\":\"https://routellm.abacus.ai/v1/chat/completions\",\"configVersion\":\"abacus-gpt-6-luna-v1\",\"policyVersion\":1,\"noticeRefs\":[\"abacus-routellm-v1\",\"openai-upstream-v1\"],\"notices\":[{\"id\":\"abacus-routellm-v1\",\"displayName\":\"Abacus.AI RouteLLM\",\"dataUseSummary\":\"Bounded purchase evidence is sent to Abacus.AI RouteLLM for the selected OpenAI GPT-6 Luna model. Abacus states customer/API content is not used to train models.\",\"retentionSummary\":\"Abacus states its upstream agreements use zero retention. Abacus itself may retain content for backup, archival or audit; no fixed duration is stated. This is not a zero-retention guarantee for the complete service.\",\"privacyUrl\":\"https://abacus.ai/privacy-policy\"},{\"id\":\"openai-upstream-v1\",\"displayName\":\"OpenAI (upstream model provider)\",\"dataUseSummary\":\"The selected GPT-6 Luna model is supplied by OpenAI through Abacus. Abacus advertises provider-managed failover; this app keeps the selected destination and model fixed.\",\"retentionSummary\":\"Processing through Abacus follows its upstream agreements. Direct OpenAI API retention settings are not asserted to apply to this intermediary service.\",\"privacyUrl\":\"https://openai.com/policies/privacy-policy/\"}],\"timeoutMs\":30000,\"maxInputBytes\":24000,\"maxOutputBytes\":65536,\"maxOutputTokens\":4096,\"models\":[{\"id\":\"gpt-6-luna\",\"capabilities\":{\"jsonSchema\":false,\"jsonObject\":true,\"outputLimit\":\"max_tokens\",\"usage\":true,\"idempotency\":false},\"pricing\":{\"version\":\"abacus-gpt-6-luna-20261013\",\"approved\":true,\"currency\":\"USD\",\"source\":\"https://routellm-apis.abacus.ai/\",\"checkedAt\":\"2026-10-13T15:40:00Z\",\"inputUsdMicrosPerMillion\":\"100000\",\"outputUsdMicrosPerMillion\":\"500000\",\"otherUsdMicrosPerMillion\":\"500000\"}}]}]",
    "AI_BUDGET_JSON": "{\"dailyDocuments\":50,\"monthlyDocuments\":500,\"dailyUnits\":1000000,\"monthlyUnits\":10000000,\"globalDailyUsdMicros\":\"1000000\",\"globalMonthlyUsdMicros\":\"10000000\"}",
    "EXTRACTION_ENABLED": "false",
    "AUTH_ALLOWED_EMAILS": "[\"mh.abolghasemi@gmail.com\"]",
    "GMAIL_ENABLED": "true",
    "MAILBOX_LIMIT": "3",
    "OUTLOOK_ENABLED": "false",
    "DRIVE_ENABLED": "false",
    "FX_REFERENCE_ENABLED": "false",
    "GMAIL_DISCOVERY_ENABLED": "false",
    "JOBS_ENABLED": "false",
    "LIFECYCLE_ENABLED": "false",
    "LIFECYCLE_GOOGLE_REVOCATION_ENABLED": "false",
    "JOBS_QUERY_LIMIT": "40",
  },
