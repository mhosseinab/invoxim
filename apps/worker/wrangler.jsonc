{
  "name": "invoxim-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "upload_source_maps": false,
  "vars": {
    "AUTH_ENABLED": "true",
    "AUTH_ORIGIN": "https://invoxim-web.pages.dev",
    "AUTH_GOOGLE_CLIENT_ID": "563909797128-8ho9ofplbgl7cu45isplfec18umknru9.apps.googleusercontent.com",
    "GMAIL_CLIENT_ID": "563909797128-s3loaq011nlfsjl1d250kcl90h1th186.apps.googleusercontent.com",
    "CORRECTIONS_ENABLED": "false",
    "EXTRACTION_ENABLED": "false",
    "AUTH_ALLOWED_EMAILS": "[\"mh.abolghasemi@gmail.com\"]",
    "GMAIL_ENABLED": "true",
    "MAILBOX_LIMIT": "3",
    "OUTLOOK_ENABLED": "false",
    "DRIVE_ENABLED": "false",
    "FX_REFERENCE_ENABLED": "false",
    "GMAIL_DISCOVERY_ENABLED": "false",
    "JOBS_ENABLED": "false",
    "LIFECYCLE_ENABLED": "false",
    "LIFECYCLE_GOOGLE_REVOCATION_ENABLED": "false",
    "JOBS_QUERY_LIMIT": "40",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "../../packages/adapters/migrations",
      "database_name": "invoxim-db",
      "database_id": "68db5cde-c850-4ca9-86cf-91669c70d4dd",
    },
  ],
}
