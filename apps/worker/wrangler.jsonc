{
  "name": "invoxim-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "upload_source_maps": false,
  "vars": {
    "AUTH_ENABLED": "false",
    "CORRECTIONS_ENABLED": "false",
    "AI_ENABLED": "false",
    "AI_HOSTED_DESTINATION": "abacus-routellm",
    "AI_HOSTED_MODEL": "gpt-6-luna",
    "EXTRACTION_ENABLED": "false",
    "GMAIL_ENABLED": "false",
    "OUTLOOK_ENABLED": "false",
    "DRIVE_ENABLED": "false",
    "FX_REFERENCE_ENABLED": "false",
    "GMAIL_DISCOVERY_ENABLED": "false",
    "JOBS_ENABLED": "false",
    "LIFECYCLE_ENABLED": "false",
    "LIFECYCLE_GOOGLE_REVOCATION_ENABLED": "false",
    "JOBS_QUERY_LIMIT": "40",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "../../packages/adapters/migrations",
      "database_name": "invoxim-db",
      "database_id": "68db5cde-c850-4ca9-86cf-91669c70d4dd",
    },
  ],
}
