{
  "name": "invoxim-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "upload_source_maps": false,
  "vars": {
    "AUTH_ENABLED": "true",
    "AUTH_ORIGIN": "https://invoxim-web.pages.dev",
    "AUTH_GOOGLE_CLIENT_ID": "563909797128-8ho9ofplbgl7cu45isplfec18umknru9.apps.googleusercontent.com",
    "GMAIL_CLIENT_ID": "563909797128-s3loaq011nlfsjl1d250kcl90h1th186.apps.googleusercontent.com",
    "CORRECTIONS_ENABLED": "true",
    "EXTRACTION_ENABLED": "true",
    "AUTH_ALLOWED_EMAILS": "[\"mh.abolghasemi@gmail.com\"]",
    "GMAIL_ENABLED": "true",
    "MAILBOX_LIMIT": "3",
    "OUTLOOK_ENABLED": "false",
    "DRIVE_ENABLED": "false",
    "FX_REFERENCE_ENABLED": "false",
    "GMAIL_DISCOVERY_ENABLED": "true",
    "JOBS_ENABLED": "true",
    "LIFECYCLE_ENABLED": "false",
    "LIFECYCLE_GOOGLE_REVOCATION_ENABLED": "false",
    "JOBS_QUERY_LIMIT": "40",
    "JOBS_DISPATCH_LIMIT": "5",
    "JOBS_SCHEDULE_LIMIT": "5",
    "JOBS_TENANT_CONCURRENCY": "2",
    "JOBS_GLOBAL_CONCURRENCY": "2",
    "JOBS_MAX_ATTEMPTS": "3",
    "JOBS_LEASE_MS": "300000",
    "JOBS_REDELIVERY_MS": "300000",
    "LANGSMITH_HOST": "https://eu.api.smith.langchain.com",
  },
  "ai": { "binding": "AI" },
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "invoxim-jobs" }],
    "consumers": [
      {
        "queue": "invoxim-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 2,
        "max_retries": 3,
        "dead_letter_queue": "invoxim-jobs-dlq",
      },
    ],
  },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "../../packages/adapters/migrations",
      "database_name": "invoxim-db",
      "database_id": "68db5cde-c850-4ca9-86cf-91669c70d4dd",
    },
  ],
}
